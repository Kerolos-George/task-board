# NestJS
PORT=3000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated frontend origins for CORS (required in production)
# Example: https://task-board.vercel.app,http://localhost:5173
FRONTEND_URL="http://localhost:5173"

# Optional: public API URL shown in Swagger (your Vercel backend URL)
# API_PUBLIC_URL="https://your-api.vercel.app"

# Supabase Postgres
# - Local migrations: Session mode (port 5432) or Direct connection
# - Vercel / serverless: Transaction pooler (port 6543) + ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
