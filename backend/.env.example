# NestJS
PORT=3000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated frontend origins (set your Vercel frontend URL in production)
FRONTEND_URL="http://localhost:5173"

# Optional public API URL for Swagger
# API_PUBLIC_URL="https://your-api.vercel.app"

# Supabase — use Transaction pooler on Vercel (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
