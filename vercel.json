{
  "buildCommand": "cd backend && npm install && npm run vercel-build",
  "outputDirectory": "backend/api",
  "functions": {
    "backend/api/index.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "backend/{api/dist/**,node_modules/**,prisma/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/backend/api/index.js"
    }
  ]
}
